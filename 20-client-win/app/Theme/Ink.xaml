<!-- 皮肤:墨白 Ink(黑白极简)。纯黑白 + 黑白线性图标(用户指定的设计理念)。
     ★ 无强调色:层次靠明度与边框,不靠彩色。风险语义色仍来自 Tokens.xaml(禁改)。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="BgWindow"    Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BgSurface"   Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BgSunken"    Color="#F2F2F2"/>
  <SolidColorBrush x:Key="BgNav"       Color="#FAFAFA"/>
  <SolidColorBrush x:Key="BgHover"     Color="#EDEDED"/>
  <SolidColorBrush x:Key="BgSelected"  Color="#1B1B1B"/>

  <SolidColorBrush x:Key="FgPrimary"   Color="#0A0A0A"/>
  <SolidColorBrush x:Key="FgSecondary" Color="#4A4A4A"/>
  <SolidColorBrush x:Key="FgMuted"     Color="#8A8A8A"/>
  <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>

  <SolidColorBrush x:Key="Accent"      Color="#0A0A0A"/>
  <SolidColorBrush x:Key="AccentHover" Color="#333333"/>
  <SolidColorBrush x:Key="Border"      Color="#D6D6D6"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#0A0A0A"/>
  <SolidColorBrush x:Key="FocusRing"   Color="#0A0A0A"/>
</ResourceDictionary>
