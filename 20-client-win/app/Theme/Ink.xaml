<!-- 皮肤:墨白 Ink(黑白极简)。纯黑白 + 黑白线性图标(用户指定的设计理念)。
     ★ 无强调色:层次靠明度与边框,不靠彩色。风险语义色仍来自 Tokens.xaml(禁改)。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="BgWindow"    Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BgSurface"   Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BgSunken"    Color="#F2F2F2"/>
  <SolidColorBrush x:Key="BgNav"       Color="#FAFAFA"/>
  <SolidColorBrush x:Key="BgHover"     Color="#EDEDED"/>
  <SolidColorBrush x:Key="BgSelected"  Color="#1B1B1B"/>

  <SolidColorBrush x:Key="FgPrimary"   Color="#0A0A0A"/>
  <SolidColorBrush x:Key="FgSecondary" Color="#4A4A4A"/>
  <SolidColorBrush x:Key="FgMuted"     Color="#8A8A8A"/>
  <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>

  <SolidColorBrush x:Key="Accent"      Color="#0A0A0A"/>
  <SolidColorBrush x:Key="AccentHover" Color="#333333"/>
  <!-- ★ 着重色反色。墨白的着重色是黑 —— 字面上的反色是白,而白在浅底上等于看不见。
       这里取"与黑白体系最不相干"的一个色:标记色的职责是【跳出来】,不是好看。 -->
  <SolidColorBrush x:Key="AccentInverse" Color="#D2691E"/>
  <SolidColorBrush x:Key="Border"      Color="#D6D6D6"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#0A0A0A"/>
  <SolidColorBrush x:Key="FocusRing"   Color="#0A0A0A"/>

  <!-- 导航选中态的前景色。必须与 BgSelected 成对定义,否则会出现同色系底+字看不清 -->
  <SolidColorBrush x:Key="FgOnSelected" Color="#FFFFFF"/>


  <!-- 项目抽屉的三种页面(说明框):描边 + 很浅的底色。墨白= 单色体系,但【危险仍是红】——
       安全语义不随皮肤走味(与 RiskDanger 同源)。 -->
  <SolidColorBrush x:Key="StateOngoingBorder" Color="#0A0A0A"/>
  <SolidColorBrush x:Key="StateOngoingFill"   Color="#FFFFFF"/>
  <SolidColorBrush x:Key="StateDoneBorder"    Color="#6B6B6B"/>
  <SolidColorBrush x:Key="StateDoneFill"      Color="#F2F2F2"/>
  <SolidColorBrush x:Key="StateTrashBorder"   Color="#C62828"/>
  <SolidColorBrush x:Key="StateTrashFill"     Color="#FBF0EF"/>

  <!-- 圆角三档跟随皮肤(用户裁定:暖萌大 / 微风中 / 墨白小)。窗口边框圆角见 WindowCorners.cs -->
  <CornerRadius x:Key="RadiusSm">2</CornerRadius>
  <CornerRadius x:Key="RadiusMd">4</CornerRadius>
  <CornerRadius x:Key="RadiusLg">6</CornerRadius>
</ResourceDictionary>
