<!-- 皮肤:暖萌 Warm(可爱风)。暖奶油底 · 珊瑚/薄荷 · 大圆角 · 宠物更萌。
     ★ 仍是实色(禁半透明);圆角在样式层放大,不在这里改 Tokens 的语义。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="BgWindow"    Color="#FBF5EC"/>
  <SolidColorBrush x:Key="BgSurface"   Color="#FFFDF9"/>
  <SolidColorBrush x:Key="BgSunken"    Color="#F4EADC"/>
  <SolidColorBrush x:Key="BgNav"       Color="#FFF8EF"/>
  <SolidColorBrush x:Key="BgHover"     Color="#FBE6DA"/>
  <SolidColorBrush x:Key="BgSelected"  Color="#F7D6C6"/>

  <SolidColorBrush x:Key="FgPrimary"   Color="#3E3129"/>
  <SolidColorBrush x:Key="FgSecondary" Color="#6E5C50"/>
  <SolidColorBrush x:Key="FgMuted"     Color="#A08D80"/>
  <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>

  <SolidColorBrush x:Key="Accent"      Color="#E2725B"/>
  <SolidColorBrush x:Key="AccentHover" Color="#C85B45"/>
  <SolidColorBrush x:Key="Border"      Color="#E8D8C7"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#D3BBA5"/>
  <SolidColorBrush x:Key="FocusRing"   Color="#E2725B"/>

  <!-- 导航选中态的前景色。必须与 BgSelected 成对定义,否则会出现同色系底+字看不清 -->
  <SolidColorBrush x:Key="FgOnSelected" Color="#5A2E1E"/>


  <!-- 项目抽屉的三种页面(说明框)。暖萌:
       ★ 进行中【不能用重点色陶土橙】—— 它和危险红几乎同一个色相,两块并排根本分不清
         (渲染诊断实拍发现)。改用同属暖色系的【鼠尾草绿】,既和奶油底协调,又与红拉开距离,
         而且"进行中=绿"与状态圆点(RiskSafe)同义。 -->
  <SolidColorBrush x:Key="StateOngoingBorder" Color="#5E8C6A"/>
  <SolidColorBrush x:Key="StateOngoingFill"   Color="#F6FAF5"/>
  <SolidColorBrush x:Key="StateDoneBorder"    Color="#8A7266"/>
  <SolidColorBrush x:Key="StateDoneFill"      Color="#F4EDE6"/>
  <SolidColorBrush x:Key="StateTrashBorder"   Color="#C9503F"/>
  <SolidColorBrush x:Key="StateTrashFill"     Color="#FBEDE9"/>

  <!-- 圆角三档跟随皮肤(用户裁定:暖萌大 / 微风中 / 墨白小)。窗口边框圆角见 WindowCorners.cs -->
  <CornerRadius x:Key="RadiusSm">10</CornerRadius>
  <CornerRadius x:Key="RadiusMd">16</CornerRadius>
  <CornerRadius x:Key="RadiusLg">22</CornerRadius>
</ResourceDictionary>
