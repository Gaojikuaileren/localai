<!-- 皮肤:暖萌 Warm(可爱风)。暖奶油底 · 珊瑚/薄荷 · 大圆角 · 宠物更萌。
     ★ 仍是实色(禁半透明);圆角在样式层放大,不在这里改 Tokens 的语义。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="BgWindow"    Color="#FBF5EC"/>
  <SolidColorBrush x:Key="BgSurface"   Color="#FFFDF9"/>
  <SolidColorBrush x:Key="BgSunken"    Color="#F4EADC"/>
  <SolidColorBrush x:Key="BgNav"       Color="#FFF8EF"/>
  <SolidColorBrush x:Key="BgHover"     Color="#FBE6DA"/>
  <SolidColorBrush x:Key="BgSelected"  Color="#F7D6C6"/>

  <SolidColorBrush x:Key="FgPrimary"   Color="#3E3129"/>
  <SolidColorBrush x:Key="FgSecondary" Color="#6E5C50"/>
  <SolidColorBrush x:Key="FgMuted"     Color="#A08D80"/>
  <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>

  <SolidColorBrush x:Key="Accent"      Color="#E2725B"/>
  <SolidColorBrush x:Key="AccentHover" Color="#C85B45"/>
  <SolidColorBrush x:Key="Border"      Color="#E8D8C7"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#D3BBA5"/>
  <SolidColorBrush x:Key="FocusRing"   Color="#E2725B"/>
</ResourceDictionary>
