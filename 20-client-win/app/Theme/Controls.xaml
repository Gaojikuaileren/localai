<!-- P3c 控件样式。目前只有滚动条 —— 用户裁定:系统滚动条太"系统"了,换成细的、融入背景的。
     做法:去掉上下箭头按钮与实心轨道,只留一根细圆角滑块;静止时低调,悬停/拖动时才明显。
     ★ 颜色一律走 DynamicResource,换肤自动跟随。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 滑块:一根细圆角条。hover / 拖动时加深,平时几乎隐入背景 -->
  <Style x:Key="SlimThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" CornerRadius="3" Margin="2"
                  Background="{DynamicResource FgMuted}" Opacity="0.32"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.60"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.78"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 翻页区做成透明:保留"点空白处翻页"的行为,但不画出轨道 -->
  <Style x:Key="InvisiblePageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 隐式样式:全应用的 ScrollBar 都用它,各视图不用单独指定 -->
  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <!-- 无箭头按钮:上下各留 0 高度,整条都是轨道 -->
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource InvisiblePageButton}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource InvisiblePageButton}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource InvisiblePageButton}" Command="ScrollBar.PageLeftCommand"/>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource SlimThumb}"/>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource InvisiblePageButton}" Command="ScrollBar.PageRightCommand"/>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 按钮:统一【圆角】(RadiusSm,随皮肤)。原生 WPF 按钮是方角系统外观(用户反馈:发送按钮没圆角)。
       用 TemplateBinding 取 Background/BorderBrush/Thickness -> Ui.Primary/Secondary/Danger 各自的配色照常生效;
       内容对齐走 HorizontalContentAlignment,导航项(靠左)不受影响。hover/按下用透明度反馈。 -->
  <Style TargetType="Button">
    <!-- 焦点纪律(用户裁定 2026-07-30):键盘焦点只归【可编辑的输入位】。
         按钮/复选框纯鼠标件 -> 整个退出焦点体系;FocusVisualStyle 清空,免得冒出系统虚线框
         (实测:Button/CheckBox/ComboBox 的默认焦点框是非 null 的,TextBox 的才是 null)。 -->
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= 滑条 =================
       自绘:细轨道 + 已选段用强调色 + 圆形滑块。和其它控件一样走令牌,不用系统外观。 -->
  <Style TargetType="Slider">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="24" VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource BgSunken}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                              Background="{DynamicResource Accent}"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Width="16" Height="16" Background="Transparent">
                        <Ellipse Fill="{DynamicResource Accent}"/>
                        <Ellipse Margin="4" Fill="{DynamicResource FgOnAccent}"/>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- ★ 竖向要【另写一套】:上面那套把轨道写死成 Height=4 + VerticalAlignment=Center,
           竖过来就散架(翻译程度改竖排时渲染诊断当场看出来的)。这里换成 Width=4 + 横向居中。
           注意 Slider 的竖向【默认最小值在下】,翻译程度要"直译在顶",
           所以由调用方设 IsDirectionReversed=true,模板不替它决定方向。 -->
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Grid Width="24" HorizontalAlignment="Center">
                <Border Width="4" CornerRadius="2" HorizontalAlignment="Center"
                        Background="{DynamicResource BgSunken}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                      <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                          <Border Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                  Background="{DynamicResource Accent}"/>
                        </ControlTemplate>
                      </RepeatButton.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Focusable="False">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid Width="16" Height="16" Background="Transparent">
                            <Ellipse Fill="{DynamicResource Accent}"/>
                            <Ellipse Margin="4" Fill="{DynamicResource FgOnAccent}"/>
                          </Grid>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                      <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                          <Border Background="Transparent"/>
                        </ControlTemplate>
                      </RepeatButton.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ================= 悬停提示:全局关闭 =================
       用户裁定(2026-07-30):取消所有"鼠标悬停弹小窗"的提示 —— 界面本身要能说明白,
       靠 tip 补说明既打断视线又遮内容。
       ★ 在【一处】关掉,而不是逐个删 ToolTip 赋值:代码里仍可留 ToolTip 作为说明性注解
       (也方便无障碍),但一律不再弹出。模板置空 + 折叠,连闪一下都不会有。 -->
  <Style TargetType="ToolTip">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= 菜单(三个点拉出的下拉)=================
       原生 ContextMenu/MenuItem 是系统外观(方角、系统蓝高亮),与整体脱节(用户反馈"太系统原生")。
       这里整套换成走令牌:圆角卡片 + 投影 · 项圆角 hover BgHover · 勾选画自绘对勾 · 子菜单自绘小箭头。
       HasDropShadow=True 是为了让弹窗允许透明(否则圆角四角会露出方角底);阴影由我们自己画。 -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUI}"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="10" Background="Transparent">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="5" SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.26" Color="Black"/>
              </Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUI}"/>
    <Setter Property="Padding" Value="9,6,9,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadiusSm}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 勾选标记:自绘对勾,不用系统的方框 -->
                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed" Margin="0,0,6,0"
                      Data="M0,4 L3,7 L9,0" Stroke="{DynamicResource Accent}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>
                <!-- 子菜单箭头 -->
                <Path x:Name="Arrow" Grid.Column="2" Visibility="Collapsed" Margin="14,0,0,0"
                      Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource FgMuted}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Right" HorizontalOffset="-6" VerticalOffset="-6"
                   PopupAnimation="Fade">
              <Border Margin="10" Background="Transparent">
                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="5">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.26" Color="Black"/>
                  </Border.Effect>
                  <StackPanel IsItemsHost="True"/>
                </Border>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 菜单里的分隔线:一根细线,不用系统的立体凹槽 -->
  <Style TargetType="Separator">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="6,4,6,4"/>
    <Setter Property="Background" Value="{DynamicResource Border}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= 输入控件 =================
       原生 WPF 的 TextBox/ComboBox/CheckBox 是方角灰边的系统外观,与整体脱节(用户反馈)。
       这里全部换成走令牌的样式:底色 BgSunken · 描边 Border · 圆角 RadiusSm(随皮肤)·
       聚焦时描边转强调色。三个皮肤自动跟随,不需要各写一套。 -->

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,6,9,6"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUI}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSm}"
                  Background="{DynamicResource BgSunken}"
                  BorderBrush="{DynamicResource Border}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                          HorizontalScrollBarVisibility="Disabled"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSurface}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 「看起来是纯文本、其实能选中复制」的只读输入框:气泡里的消息正文用它。
       ★ 为什么必须另起一套模板:上面那套 TextBox 模板把 Background 写死成 BgSunken
       (不是 TemplateBinding),所以在代码里设 Background=Transparent 根本不起作用 ——
       结果就是消息正文顶着一块灰底,配上气泡的白字变成"灰底白字"看不清(用户反馈)。
       这里连边框带底色一起去掉,只留承载文字的 PART_ContentHost。
       Background 用 Transparent 而不是 null:null 不参与命中测试,就选不中了。 -->
  <Style x:Key="PlainTextBox" TargetType="TextBox">
    <!-- ★ 只读正文【退出 Tab 序,但保留可聚焦】:不加这句的话 Tab 会停在【每一条消息】上,
         一条长会话要按上百次才轮到输入框,而且 TextBox 的默认焦点框是 null ——
         完全没有视觉反馈,用起来就像"Tab 键坏了"。
         保留 Focusable 是因为鼠标拖选/Ctrl+C 全靠它,那正是这个只读框存在的唯一理由。 -->
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUI}"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollBarVisibility="Disabled"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- V20-⑤:渲染过 markdown 的消息正文。与 PlainTextBox 逐条同构 ——
       两者会在同一屏里并排出现(有记号的走这个、没记号的走那个),
       只要有一条设置不一样,用户就会看到两种长得不同的气泡。
       ★ 模板里两个方向都 Disabled:RichTextBox 自带的 ScrollViewer 会把滚轮吃掉,
         而它就住在会话区那个 ScrollViewer 里面(嵌套滚动 = 滚轮落在气泡上时整屏不动)。 -->
  <Style x:Key="PlainRichTextBox" TargetType="RichTextBox">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUI}"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
    <!-- ★ 富文本里不要出现"可点的东西":这段文字是模型生成的,
         让它带着可激活的超链接等于让模型决定打开哪个网站(见 MarkdownText.Fill)。 -->
    <Setter Property="IsDocumentEnabled" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RichTextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollBarVisibility="Disabled"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 复选框:自绘方框 + 勾,不用系统外观 -->
  <Style TargetType="CheckBox">
    <!-- 同 Button:纯鼠标件,退出焦点体系(空格勾选随之取消,鼠标不受影响) -->
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUI}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="16" Height="16" VerticalAlignment="Center"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Background="{DynamicResource BgSunken}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Path x:Name="Tick" Visibility="Collapsed" Stretch="Uniform" Margin="3"
                    Data="M0,4 L3,7 L9,0" Stroke="{DynamicResource FgOnAccent}"
                    StrokeThickness="1.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 下拉项 -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="Padding" Value="9,6,9,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                  CornerRadius="{DynamicResource RadiusSm}" Margin="3,1,3,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSelected}"/>
              <Setter Property="Foreground" Value="{DynamicResource FgOnSelected}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 下拉框:自绘按钮 + 弹出列表,与文本框同一套描边/圆角/底色 -->
  <Style TargetType="ComboBox">
    <!-- ★ 下拉框与按钮不同:【退出 Tab 序,但保留可聚焦】。
         Tab 永远不会跳到它上面;而鼠标点开之后它照样能拿到焦点,
         于是上下键选项、首字母跳转仍然可用 —— 两头都不丢。
         判据不是"是不是输入控件",而是"Tab 该不该停在这"。 -->
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUI}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_ToggleButton" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusSm}"
                          Background="{DynamicResource BgSunken}"
                          BorderBrush="{DynamicResource Border}" BorderThickness="1"
                          SnapsToDevicePixels="True">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                          Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource FgMuted}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSurface}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="9,6,26,6" VerticalAlignment="Center"/>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
              <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Margin="0,4,6,6"
                      CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource BgSurface}"
                      BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

