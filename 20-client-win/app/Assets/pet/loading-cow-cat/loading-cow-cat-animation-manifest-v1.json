    { "from": "behind_door", "to": "stand", "clip": "door_exit", "must_finish": true, "priority": 30 },
    { "from": "*visible", "to": "dangle", "clip": "grab_start", "must_finish": true, "preempt": false, "at_event": "grab_eligible", "request_mode": "defer_until_current_must_finish", "priority": 90 },
    { "from": "dangle", "to": "stand", "clip": "drop_land", "must_finish": true, "preempt": true, "priority": 90 },
    { "from": "*any", "to": "suspended", "clip": null, "must_finish": false, "preempt": true, "priority": 100 }
  ],
  "event_priority": [
    "suspend_exclusive_fullscreen_lease_lost_or_exit",
    "loading_layer_event",
    "drag_lifecycle",
    "current_must_finish_clip",
    "door_transaction",
    "explicit_behavior_or_assistant_request",
    "locomotion_facing_or_posture_target",
    "idle_insert"
  ],
  "parallel_layers": ["loading_spinner"],
  "loading_contract": {
    "activation": "active_loading_ids set is non-empty",
    "body_queue_independent": true,
    "anchor_field": "fx_anchor",
    "hidden_in_states": ["suspended", "behind_door"],
    "resume_phase": "monotonic_clock_sync_no_catch_up"
  },
  "runtime_contracts": {
    "scratch_door_cancel": "leave only at exit_seam; frame must match idle_stand ground contact",
    "grab_sources": "one shared grab_start; v1a accepts at most one tick of pose normalization",
    "grab_eligibility": "stable idle next tick; walk at paw_down; scratch_door at exit_seam; defer while must_finish",
    "sitting_or_loaf_turn": "return to stand before turn_180",
    "system_suspend": "cancel door transaction and resume through wake_from_hidden"
  },
  "budgets": {
    "input_declared_v1a_body_frames": 82,
    "audited_v1a_body_frames": 84,
    "v1a_loading_frames": 12,
    "audited_full_body_frames": 168,
    "full_loading_frames": 12,
    "full_sleep_reuse_body_frames": 159,
    "full_mobility_cut_body_frames": 142,
    "full_sleep_reuse_and_mobility_cut_body_frames": 133
  },
  "optimizations": {
    "sleep_reuse": {
      "reuse_sprite": "blink_loaf_closed",
