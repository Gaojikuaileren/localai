    { "from": "stalk", "to": "stand", "clip": "pounce", "must_finish": true, "priority": 30 },
    { "from": "stand", "to": "scratch_door", "clip": null, "must_finish": false, "at_event": "can_exit", "priority": 30 },
    { "from": "scratch_door", "to": "stand", "clip": null, "must_finish": false, "at_event": "exit_seam", "priority": 30 },
