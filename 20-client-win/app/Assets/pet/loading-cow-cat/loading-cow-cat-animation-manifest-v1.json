    },
    "mobility_cut": {
      "omit_clips": ["trot", "run", "stalk", "pounce"],
      "saved_body_frames": 26,
      "changes_v1a_total": false
    },
    "hard_82_option": {
      "clip": "stand_to_walk",
      "rule": "reference idle_stand final sprite and walk first sprite; author zero new sprites",
      "requires_manifest_change": true
    }
  }
