<Window x:Class="LocalAI.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="本地 AI 中枢" Height="900" Width="1440" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}"
        FontFamily="{DynamicResource FontUI}"
        FontSize="{DynamicResource FontBody}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
  <!-- 自绘标题栏:用 WindowChrome,而不是 WindowStyle=None + AllowsTransparency。
       后者会让整窗走 layered window 合成,显存/性能成本比它想替代的毛玻璃还高(设计 §7 显存约束);
       WindowChrome 则保留系统的拖动、双击最大化、Aero Snap、投影与调整边框。 -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- 窗口按钮:方形、无边框、hover 才显底色;关闭键 hover 用恒定风险红(设计 §7 风险语义色皮肤禁改) -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RiskDanger}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>   <!-- 自绘标题栏(贯通全宽) -->
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ================= 标题栏 ================= -->
    <Border Grid.Row="0" Background="{DynamicResource BgNav}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 品牌 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource Accent}" Margin="0,0,9,0"/>
          <TextBlock Text="本地 AI 中枢" FontWeight="SemiBold" FontSize="12.5"
                     Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 中间空白 = 拖动区(CaptionHeight=0,所以靠 MouseLeftButtonDown 触发 DragMove) -->
        <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag"/>

        <!-- 窗口按钮:Segoe MDL2 图标 最小化 E921 / 最大化 E922 / 还原 E923 / 关闭 E8BB -->
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" ToolTip="最小化" Click="OnMinimize"/>
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" ToolTip="最大化" Click="OnMaximizeRestore"/>
          <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" ToolTip="关闭(留在托盘)" Click="OnCloseClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 主体:左导航 + 右内容 ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左导航 -->
      <Border Grid.Column="0" Background="{DynamicResource BgNav}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- 收起按钮 -->
          <Grid DockPanel.Dock="Top" Height="40" Margin="8,4,8,0">
            <Button x:Name="CollapseButton" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource FgMuted}" Cursor="Hand"
                    ToolTip="收起导航" Click="OnToggleNav"/>
          </Grid>

          <!-- 底部:显存条(在"当前成员/纠正"上方) + 当前成员 -->
          <Border DockPanel.Dock="Bottom" Margin="10,8,10,12" Padding="10,8"
                  Background="{DynamicResource BgSunken}" CornerRadius="{DynamicResource RadiusMd}">
            <StackPanel>
              <TextBlock x:Name="MemberText" Foreground="{DynamicResource FgPrimary}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="MemberHint" Foreground="{DynamicResource FgMuted}"
                         FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <ContentControl x:Name="VramHost" DockPanel.Dock="Bottom" Margin="12,0,12,0"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="NavPanel" Margin="10,0,10,0"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 右侧:页面顶栏 + 内容 + 底部任务横条 -->
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" Height="54" Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <Grid Margin="24,0,16,0">
            <TextBlock x:Name="PageTitle" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource FgMuted}"/>
              <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource FgSecondary}"
                         FontSize="{DynamicResource FontCaption}" Margin="0,0,14,0"/>
              <!-- 全局日历按钮。★ 主页里【不显示】—— 日历已经在主页右上角了(用户裁定)。 -->
              <Button x:Name="CalendarButton" Width="34" Height="34" Cursor="Hand"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource FgSecondary}" ToolTip="日历" Click="OnOpenCalendar"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 底部任务横条:有任务才出现,空闲自动隐藏(设计 §3)。只显示简要 + 进度;
             多个任务随时间自动轮播;点整条打开【全局】任务抽屉。 -->
        <Border x:Name="TaskBar" DockPanel.Dock="Bottom" Height="48" Visibility="Collapsed"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Cursor="Hand" MouseLeftButtonUp="OnToggleTaskDrawer">
          <Grid Margin="24,0,16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ContentControl x:Name="TaskBarIcon" Margin="0,0,10,0" VerticalAlignment="Center" Focusable="False"/>
              <TextBlock x:Name="TaskBarTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                         Foreground="{DynamicResource FgPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
              <TextBlock x:Name="TaskBarDetail" VerticalAlignment="Center" Margin="12,0,0,0"
                         Foreground="{DynamicResource FgMuted}" FontSize="{DynamicResource FontCaption}"
                         TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <ProgressBar x:Name="TaskBarProgress" Width="160" Height="4" Minimum="0" Maximum="1"
                           Foreground="{DynamicResource Accent}" Background="{DynamicResource BgSunken}"
                           BorderThickness="0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TaskBarPercent" VerticalAlignment="Center" Margin="10,0,12,0"
                         Foreground="{DynamicResource FgSecondary}" FontSize="{DynamicResource FontCaption}"/>
              <TextBlock x:Name="TaskBarCount" VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="{DynamicResource FgMuted}" FontSize="{DynamicResource FontCaption}"/>
              <ContentControl x:Name="TaskBarChevron" VerticalAlignment="Center" Focusable="False"/>
            </StackPanel>
          </Grid>
        </Border>

        <ContentControl x:Name="ContentHost"/>
      </DockPanel>
    </Grid>

    <!-- ============ 全局面板(两个方向,用户裁定)============
         日历 = 从【右上角】拉开(锚在顶栏日历按钮下方);
         任务 = 从【下往上】升起(锚在底部任务横条上方)。
         都挂在外壳上 -> 任何界面都能开。遮罩用实色低透明,不是毛玻璃(设计 §7 显存约束)。 -->
    <Border x:Name="DrawerScrim" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="50"
            Background="#28000000" Visibility="Collapsed"
            MouseLeftButtonDown="OnCloseDrawer"/>

    <!-- 日历:右上角下拉 -->
    <Border x:Name="CalendarDrawer" Grid.Row="1" Panel.ZIndex="60" Width="420" MaxHeight="620"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,54,16,0" Visibility="Collapsed"
            Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMd}"
            RenderTransformOrigin="1,0">
      <Border.RenderTransform>
        <ScaleTransform x:Name="CalendarDrawerScale" ScaleY="1"/>
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.18" Color="Black"/>
      </Border.Effect>
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="46" Margin="16,0,8,0">
          <TextBlock Text="日历" VerticalAlignment="Center" FontWeight="SemiBold"
                     FontSize="{DynamicResource FontSubtitle}" Foreground="{DynamicResource FgPrimary}"/>
          <Button x:Name="CalendarDrawerClose" Width="30" Height="30" HorizontalAlignment="Right" Cursor="Hand"
                  Background="Transparent" BorderThickness="0" Click="OnCloseDrawer"/>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Border}"/>
        <ContentControl x:Name="CalendarDrawerHost" Margin="16,12,16,16"/>
      </DockPanel>
    </Border>

    <!-- 任务:底部升起 -->
    <Border x:Name="TaskDrawer" Grid.Row="1" Panel.ZIndex="60" MaxHeight="380"
            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
            Margin="0,0,0,0" Visibility="Collapsed"
            Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
            RenderTransformOrigin="0.5,1">
      <Border.RenderTransform>
        <TranslateTransform x:Name="TaskDrawerSlide" Y="0"/>
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="-3" Direction="270" Opacity="0.16" Color="Black"/>
      </Border.Effect>
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="46" Margin="24,0,12,0">
          <TextBlock Text="正在进行的任务" VerticalAlignment="Center" FontWeight="SemiBold"
                     FontSize="{DynamicResource FontSubtitle}" Foreground="{DynamicResource FgPrimary}"/>
          <Button x:Name="TaskDrawerClose" Width="30" Height="30" HorizontalAlignment="Right" Cursor="Hand"
                  Background="Transparent" BorderThickness="0" Click="OnCloseDrawer"/>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Border}"/>
        <ContentControl x:Name="TaskDrawerHost" Margin="24,14,24,18"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
