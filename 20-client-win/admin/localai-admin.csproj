<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 与客户端同一个 TFM:两边编译**同一批**界面源码,框架版本不同会让"同一份文件"名不副实 -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LocalAI.Admin</RootNamespace>
    <AssemblyName>localai-admin</AssemblyName>
    <!-- ══════════════════════════════════════════════════════════════════════
         V29(实机反馈⑩)· 管理端**自己的**图标。在此之前这里**根本没有这一行**,
         于是 exe / 任务栏用的是 .NET 默认图标,托盘用的是 `SystemIcons.Application`
         (通用 Windows 图标)—— 两处都是默认,不是"有一个但不合适"。

         图案 = 客户端那只猫**左右镜像** + **黑换成红**(#D93025,仓里那条恒定风险语义色)。
         · 镜像成立的前提先确认过:图案**不对称**(星芒压一侧、一只耳朵有缺口),
           对称的话镜像等于什么都没做;
         · 白色与 alpha 原样保留,抗锯齿灰按亮度在 红↔白 之间插值 ——
           不是"整块涂红",不然边缘会毛。
         ★★ 为什么托盘也必须换(不是好看):`RealCloseAsync` 是**唯一**的真关闭入口,
            全靠用户在托盘里认出是哪一个。两个 exe 的托盘图标长得一样,用户会点错。
         ★ 资产在 `app/Assets/icon/admin/`(全套尺寸 PNG + admin.ico),
           与客户端那套**并排放**,一眼看得出是同一族的两只。
         ══════════════════════════════════════════════════════════════════════ -->
    <ApplicationIcon>..\app\Assets\icon\admin\admin.ico</ApplicationIcon>
    <!-- 自定义入口:先做单实例与提权判断,再进 WPF(同客户端 Program.cs 的理由) -->
    <StartupObject>LocalAI.Admin.Program</StartupObject>
  </PropertyGroup>

  <!-- ══════════════════════════════════════════════════════════════════════════
       裁定④ · UI 共享:**link 源码,不新建类库,也不复制**。

       ★ 为什么不新建类库:结构断言靠**全仓扫源码**,而多一个程序集就多一层边界 ——
         V12 刚踩过同族的一次(发布产物里读不到源码,ASSERTION-PITFALLS 第 11 条);
         而且「客户端源码里不得出现停进程 API」这类判据要么漏掉那个类库、要么得记得扩范围,
         **漏掉是静默的**。link 源码则两个 csproj 编译**同一批文件**,扫源码的判据自然覆盖到。
       ★ 这与 D93 裁定④(WireContracts.cs 由三个 csproj 编译同一份)是同一条手法。

       ★★ `<Link>` 不是排版:XAML 资源字典靠 `pack://application:,,,/Theme/X.xaml` 取,
         而 MSBuild 对**项目目录之外**的文件默认只取文件名 ⇒ 会变成 `/X.xaml`,
         运行时找不到、换肤当场炸。必须显式把逻辑路径写回 `Theme\X.xaml`。
       ══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <!-- 皮肤字典(三皮肤)+ 令牌 + 控件样式。Tokens 里是禁改的风险/范围语义色。 -->
    <Page Include="..\app\Theme\Tokens.xaml"><Link>Theme\Tokens.xaml</Link></Page>
    <Page Include="..\app\Theme\Controls.xaml"><Link>Theme\Controls.xaml</Link></Page>
    <Page Include="..\app\Theme\Breeze.xaml"><Link>Theme\Breeze.xaml</Link></Page>
    <Page Include="..\app\Theme\Ink.xaml"><Link>Theme\Ink.xaml</Link></Page>
    <Page Include="..\app\Theme\Warm.xaml"><Link>Theme\Warm.xaml</Link></Page>

    <!-- 换肤与图标 -->
    <Compile Include="..\app\Theme\ThemeManager.cs"><Link>Theme\ThemeManager.cs</Link></Compile>
    <Compile Include="..\app\Theme\Icons.cs"><Link>Theme\Icons.cs</Link></Compile>

    <!-- 704 行界面原语(裁定④逐个点名的那五个) -->
    <Compile Include="..\app\Views\Ui.cs"><Link>Views\Ui.cs</Link></Compile>
    <Compile Include="..\app\Views\Layout.cs"><Link>Views\Layout.cs</Link></Compile>
    <Compile Include="..\app\Views\Flyout.cs"><Link>Views\Flyout.cs</Link></Compile>
    <Compile Include="..\app\Views\MenuHost.cs"><Link>Views\MenuHost.cs</Link></Compile>
    <Compile Include="..\app\Views\Overlay.cs"><Link>Views\Overlay.cs</Link></Compile>

    <!-- ══════════════════════════════════════════════════════════════════════
         V29(2026-08-09 实机反馈①)· 滚轮让路。**V21 搬 3100 行时漏的就是这一个。**
         `Ui.Page(...)` 返回的外层 ScrollViewer 一直都在,而内层(尤其是 TextBox 模板里的
         `PART_ContentHost`)把滚轮**无条件吞掉** ⇒ 用户报的「滚轮不是全局可滚」。
         接线在 `admin/Views/AdminScroll.cs`(类处理器,一网打尽),让路逻辑就是这一份。

         ★★ WheelPicker.cs 是**被迫**一起链的,不是顺手:`Wheel.cs:28` 调
            `WheelColumn.IsInsideWheel(...)`,只链 Wheel.cs 会 CS0103。
            ⇒ 管理端今天没有转盘,但**这一份不许在管理端另写一个空壳替身** ——
              替身会让「转盘里让路」这条规矩在两个 exe 里各有一份判断。
         ★ 两条都是 `<Compile Link>`,与裁定④ / D93 裁定④同款手法:不复制。 -->
    <Compile Include="..\app\Views\Wheel.cs"><Link>Views\Wheel.cs</Link></Compile>
    <Compile Include="..\app\Views\WheelPicker.cs"><Link>Views\WheelPicker.cs</Link></Compile>

    <!-- V29(实机反馈④)· 窗口圆角跟皮肤走。管理端换成自绘标题栏之后要和客户端一样圆 ——
         ★ 这是**同一份** DWM 调用(`WindowCorners.Apply`),不在管理端另写一套:
           「哪套皮肤圆多少」是一条判断,两份漂了不会有任何东西红。 -->
    <Compile Include="..\app\Services\WindowCorners.cs"><Link>Services\WindowCorners.cs</Link></Compile>

    <!-- 上面那些依赖的:Skin 枚举与设置读写(皮肤同步要读它)· 称谓(Ui.Title 等会过 Vocab)·
         客户端状态目录(管理端要读客户端的 settings.json、也要探它的锁文件) -->
    <Compile Include="..\app\Services\AppSettings.cs"><Link>Services\AppSettings.cs</Link></Compile>
    <Compile Include="..\app\Services\Vocab.cs"><Link>Services\Vocab.cs</Link></Compile>
    <Compile Include="..\app\Services\AppPaths.cs"><Link>Services\AppPaths.cs</Link></Compile>
    <Compile Include="..\app\Services\Languages.cs"><Link>Services\Languages.cs</Link></Compile>

    <!-- 三语文案:Ui.Title/Body 会过 Vocab.Apply,而 Vocab 按**界面语言**取称谓词对。
         ★ 链 Strings.cs **并且**把 strings.json 一起嵌进来 —— 只链 .cs 的话它在运行时
           找不到嵌入资源,表现是文案整片回退,而编译期一声不吭。 -->
    <Compile Include="..\app\I18n\Strings.cs"><Link>I18n\Strings.cs</Link></Compile>
    <EmbeddedResource Include="..\app\I18n\strings.json"><Link>I18n\strings.json</Link></EmbeddedResource>

    <!-- 单实例:排他按用户(锁文件)、唤醒/退出按会话(命名事件)。与客户端**同一份**源码 ——
         「请你优雅退出」那个事件的名字由这一个文件算出来,两边编译同一份 ⇒ 没法各持一份期望值。 -->
    <Compile Include="..\app\Services\InstanceLock.cs"><Link>Services\InstanceLock.cs</Link></Compile>
    <Compile Include="..\app\Services\SingleInstance.cs"><Link>Services\SingleInstance.cs</Link></Compile>

    <!-- D46 提权护栏:与客户端**同一份**判据(先试着打开密钥,而不是问"我是不是管理员")。
         Elevation 要 Ca.TlsKeyProvider,所以把 Ca.cs 一并链进来 —— 和客户端 csproj 的做法一致。 -->
    <Compile Include="..\app\Services\Elevation.cs"><Link>Services\Elevation.cs</Link></Compile>
    <Compile Include="..\..\10-core\identity\Ca.cs"><Link>Identity\Ca.cs</Link></Compile>

    <!-- ══════════════════════════════════════════════════════════════════════
         V19(2026-08-08)· phase 2 迁移的**前置**:这两份现在就链好,
         不等搬到一半才发现编不过。

         ★ ProcRun.cs:`RunCapturedAsync` 原是 HostSetup 的私有方法,而拆分会把
           HostSetup 切成两半(IdentityExistsAsync 留客户端 / EnsureIdentityAsync 搬过来),
           **两半都用它**。不提出来的话,切分那天最省事的写法就是复制一份 ——
           而两份漂了不会有任何东西红。理由全文在 ProcRun.cs 顶部。
         ★ ConfirmDialog.cs:批准弹窗与删除确认(DevicesView / StorageView)全靠它,
           搬过去就编不过。★ 它同时是**六词比对**那句断言的载体
           (按钮文字本身就是判词),复制一份过来 = 那句判词从此可以各改各的。
         ★★ 两条都是 `<Compile Link>`,**不许复制**(裁定④ / D93 裁定④同款手法)。
              链了之后再往 admin\ 里放一份同名同 namespace 的副本 ⇒ CS0101 编译失败,
              那一层是结构性的,不靠判断挡住。
         ══════════════════════════════════════════════════════════════════════ -->
    <Compile Include="..\app\Services\ProcRun.cs"><Link>Services\ProcRun.cs</Link></Compile>
    <Compile Include="..\app\Views\ConfirmDialog.cs"><Link>Views\ConfirmDialog.cs</Link></Compile>

    <!-- ★ 「除 ConfirmDialog 外还缺哪些」核了一遍,判官是 **dotnet build**,不是 grep ——
           第一版正则清单里 15 个候选,实测有 4 个是误报(Snapshot / Kind / Page 等)。
         下面三条是**实测链得动、且闭合**的(加进来 0 error):
           · BuildInfo    —— DevicesView:624 `BuildInfo.Display`;
           · VramBudget   —— ComponentPicker:271 `VramBudget.PeakSumGiB`;
           · HubDiscovery —— HubAdmin:531/545 与 DevicesView:1172 **两边都用**,
             它要 `LocalAI.Identity.HubId`,所以那一份**成对链进来**(单链会 CS0234)。
         ★★ 还有 7 个**链不动** —— 它们不是 csproj 缺条目,是迁移本身要先裁的依赖。
            逐个实测的错误已写进 decision-packets/admin-app-phase2-prereqs-2026-08-08.md §A3。 -->
    <Compile Include="..\app\Services\BuildInfo.cs"><Link>Services\BuildInfo.cs</Link></Compile>
    <Compile Include="..\app\Services\VramBudget.cs"><Link>Services\VramBudget.cs</Link></Compile>
    <Compile Include="..\app\Services\HubDiscovery.cs"><Link>Services\HubDiscovery.cs</Link></Compile>
    <Compile Include="..\..\10-core\identity\HubId.cs"><Link>Identity\HubId.cs</Link></Compile>

    <!-- ══════════════════════════════════════════════════════════════════
         V21(2026-08-08)· 3100 行迁移带过来的**共享源码**。
         ★★ 一条都不是复制:两个 csproj 编译**同一个文件**(裁定④ / D93 裁定④同款手法)。
            复制的那天两份会漂,而漂了**不会有任何东西红** —— 这正是本仓最恨的形状。

         · AdminApp.cs   —— 出包布局(旁边装没装 admin / host)。**判据留客户端**:
           角色判定的第一条证据就是它,设置里那颗「打开管理端面板」按钮也靠它。
           而管理端这边 `HostProvision` / `HubAdmin.StartEdgeCmd` 也要问同一个问题。
         · HostSetup.cs  —— **角色判据那一半**(见该文件头)。管理端起网关时读的
           `GatewayPort` / `GatewayUpAsync` 就是客户端拨号读的那两个 ——
           两处各写一个字面量的话,「客户端拨到哪儿」与「管理端起在哪儿」会静默漂成两个数。
         · GpuWire.cs    —— `HubGpu` 的**解析那一半**(partial)。组件面板搬过来之后
           两边读同一份 `ParseCatalog` / `ParseOutcome`,不存在第二个解析器(V4 修过一次的缺陷)。
         · WireContracts.cs —— `/admin/*` 那几组响应形状的**唯一登记表**,与 lan-edge 同一份。
         ══════════════════════════════════════════════════════════════════ -->
    <Compile Include="..\app\Services\AdminApp.cs"><Link>Services\AdminApp.cs</Link></Compile>
    <Compile Include="..\app\Services\HostSetup.cs"><Link>Services\HostSetup.cs</Link></Compile>
    <Compile Include="..\app\Services\GpuWire.cs"><Link>Services\GpuWire.cs</Link></Compile>
    <Compile Include="..\..\10-core\identity\WireContracts.cs"><Link>Identity\WireContracts.cs</Link></Compile>

    <!-- 记忆库搬过来带的三个小依赖。★ 都是「一份定义两处编」,理由分别写在各自文件头上:
         · ProjectScope.cs  —— 各写一份会让 D45 的三档范围在两个进程里序号漂开,而**不会红**;
         · MemberContext.cs —— 可见范围判定(fail-closed),两份判据就是两套安全性质;
         · ClientStore.cs   —— 原子写 + 坏档留证(D50 那四条硬约束)。★ 管理端用它写的是
           **自己那份** `admin\memory.json`,路径由调用方给 —— 它本身不认哪个目录。 -->
    <Compile Include="..\app\Services\ProjectScope.cs"><Link>Services\ProjectScope.cs</Link></Compile>
    <Compile Include="..\app\Services\MemberContext.cs"><Link>Services\MemberContext.cs</Link></Compile>
    <Compile Include="..\app\Services\ClientStore.cs"><Link>Services\ClientStore.cs</Link></Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- 与客户端同款:UseWindowsForms 的隐式 using 会与 WPF 撞名(CS0104)。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <!-- V21:链进来的 `HostSetup.GatewayUpAsync` 用 HttpClient 探 /health。
         ★ 与客户端 csproj 逐字一致 —— WPF/WinForms 工程的隐式 using 集合缺 System.Net.Http。 -->
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- App.xaml 降为 Page:否则 WPF 自动生成的 Main 会与 Program.Main 冲突(CS0017) -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
</Project>
