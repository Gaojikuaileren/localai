# =============================================================================
#  .gitignore — 本地 AI 中枢
#  原则:代码进 git,数据绝不进 git(方案书 v2.1 §11「五个逻辑根」)
# =============================================================================

# --- 模型权重:绝不进 git ---------------------------------------------------
*.safetensors
*.ckpt
*.gguf
*.pt
*.pth
*.bin
*.onnx
*.msgpack
*.h5

# --- 环境与密钥 -------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
secrets.*
credentials.*
config/paths.local.toml

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Node -------------------------------------------------------------------
node_modules/
.next/
.turbo/
*.tsbuildinfo

# --- Rust / Tauri -----------------------------------------------------------
target/
20-client-win/**/target/

# --- 数据与产物(万一有人在 code 根下误建同名目录)-------------------------
/models/
/assets/
/state/
/cache/
/backup/

# --- 日志与临时 -------------------------------------------------------------
*.log
*.tmp
tmp/
.cache/

# --- 系统 -------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
